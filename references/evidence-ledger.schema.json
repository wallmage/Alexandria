{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wallmage/Alexandria/references/evidence-ledger.schema.json",
  "title": "Alexandria Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "research_question",
    "brief",
    "people",
    "report_date",
    "coverage",
    "sources",
    "claims",
    "synthesis",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverageItem"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "synthesis": {
      "$ref": "#/$defs/synthesis"
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "excluded_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "reason", "dropped_at"],
        "additionalProperties": true,
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "dropped_at": {
            "type": "string"
          }
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alx_version": {
          "type": "string"
        },
        "state_path": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "intended_reader",
        "decision_or_use",
        "archetype",
        "report_language",
        "editorial_mode",
        "scope"
      ],
      "properties": {
        "intended_reader": {
          "type": "string",
          "minLength": 1
        },
        "decision_or_use": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "enum": [
            "artifact",
            "concept",
            "event",
            "organization",
            "person",
            "system",
            "hybrid"
          ]
        },
        "report_language": {
          "enum": ["en", "zh-CN", "zh-HK"]
        },
        "editorial_mode": {
          "enum": [
            "analytical",
            "narrative",
            "explanatory",
            "investigative",
            "historical",
            "critical"
          ]
        },
        "scope": {
          "type": ["object", "string", "null"],
          "additionalProperties": true
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "area",
        "question",
        "priority",
        "decision_relevance",
        "completion_criteria",
        "status",
        "claim_ids",
        "gap_impact"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["supported", "disputed"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "claim_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "gap"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "claim_ids": {
                "maxItems": 0
              },
              "gap_impact": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": ["high", "medium", "low"]
        },
        "decision_relevance": {
          "type": "string",
          "minLength": 1
        },
        "completion_criteria": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["unstarted", "in_progress", "supported", "disputed", "gap"]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "gap_impact": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "url",
        "publisher",
        "accessed",
        "provenance",
        "evidence_type",
        "source_family",
        "roles",
        "accountability_basis"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": ["string", "null"]
        },
        "published": {
          "type": ["string", "null"],
          "format": "date"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "provenance": {
          "enum": [
            "primary_independent",
            "primary_interested",
            "secondary_independent",
            "secondary_dependent",
            "unverified"
          ]
        },
        "evidence_type": {
          "enum": [
            "accountable_record",
            "peer_reviewed",
            "preprint",
            "official_documentation",
            "dataset_or_test",
            "reported_interview",
            "news_report",
            "opinion_or_forecast",
            "marketing",
            "anecdote"
          ]
        },
        "source_family": {
          "description": "Independence family. Default to the source URL's registrable domain (or its leading label). Any other value needs family_justification.",
          "type": "string",
          "minLength": 1
        },
        "family_justification": {
          "description": "Why this source is genuinely independent of the other sources sharing its host or registrable domain. Required to override the domain-derived family or to carry a different provenance class from a same-host source.",
          "type": ["string", "null"],
          "minLength": 20
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "subject_official",
              "counterparty_official",
              "independent_analysis",
              "empirical_data",
              "affected_stakeholder",
              "expert_interpretation",
              "historical_record"
            ]
          },
          "uniqueItems": true
        },
        "accountability_basis": {
          "enum": [
            "none",
            "court_or_regulator_record",
            "named_source_investigation",
            "subject_admission"
          ]
        },
        "accountability_note": {
          "type": ["string", "null"],
          "minLength": 20
        },
        "limitations": {
          "type": ["string", "null"]
        },
        "undated_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "person_id": {
          "type": "string",
          "pattern": "^P[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "living_status": {
          "enum": ["living", "recently_deceased", "deceased", "unknown", null]
        },
        "public_role": {
          "enum": ["public", "limited_public", "private", null]
        },
        "relationship": {
          "enum": ["primary_subject", "adjacent", null]
        }
      }
    },
    "namedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subject_type", "person_id"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "description": "Semantic subject type. Organization is not a self-attested safety bypass: validation rejects names that independently resolve as people.",
          "enum": ["person", "organization"]
        },
        "person_id": {
          "type": ["string", "null"],
          "pattern": "^P[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "subject_type": {"const": "person"}
            },
            "required": ["subject_type"]
          },
          "then": {
            "properties": {
              "person_id": {
                "type": "string",
                "pattern": "^P[0-9]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subject_type": {"const": "organization"}
            },
            "required": ["subject_type"]
          },
          "then": {
            "properties": {
              "person_id": {"type": "null"}
            }
          }
        }
      ]
    },
    "searchRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "expected_locations", "searched_at"],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expected_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "searched_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "triangulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "enum": ["met", "limited", "not_applicable"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "extract_or_location"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "extract_or_location": {
          "description": "The exact extract or precise location supplied by this individual source. Each source record is validated independently and may not borrow a carrier, value, comparator, or unit from another record. Quantitative evidence must identify the claim's complete canonical metric carrier and preserve prefix or postfix comparators plus complete symbolic or worded unit syntax; a bare figure is insufficient. Live fidelity checks bind probes to this source only.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claim_id", "claim"],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            },
            "required": ["source_ids"]
          },
          "then": {
            "properties": {
              "source_evidence": {
                "minItems": 1
              }
            },
            "required": ["source_evidence"]
          }
        }
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^C[0-9]+$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["fact", "reported_claim", "estimate", "analysis"]
        },
        "importance": {
          "enum": ["key", "supporting", "context"]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "uniqueItems": true
        },
        "extract_or_location": {
          "description": "The quoted or located evidence behind claim. Every source_evidence record is checked independently. Every quantitative token must preserve its prefix or postfix comparator, full symbolic or worded unit syntax, and complete canonical metric carrier; a bare figure is insufficient. Every quantitative token and status assertion must be covered here or declared in derived_assertions.",
          "type": ["string", "null"]
        },
        "source_evidence": {
          "description": "One evidence record per direct source_id. Cross-reference validation requires exact, unique coverage.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceEvidence"
          }
        },
        "as_of": {
          "description": "The date the claim was true of the world.",
          "type": ["string", "null"],
          "format": "date"
        },
        "verified_at": {
          "description": "The date the extract was last re-read against the live source. Distinct from as_of: re-dating a claim is not re-verifying it.",
          "type": ["string", "null"],
          "format": "date"
        },
        "assumptions": {
          "description": "Stated inputs and steps behind original arithmetic. Required for kind estimate.",
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "minLength": 20
          },
          "uniqueItems": true
        },
        "derived_assertions": {
          "description": "Narrow escape hatch: assertions in claim that are computed or inferred rather than quoted. Each entry names the exact expression and states its derivation. Not for restating the source.",
          "type": ["array", "null"],
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expression", "derivation"],
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "derivation": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "status": {
          "enum": ["supported", "disputed", "inference", "unknown"]
        },
        "include_in_report": {
          "type": "boolean"
        },
        "report_excerpts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          },
          "uniqueItems": true
        },
        "supports": {
          "description": "Strictly downward: the claims this claim rests on. Listing B in A.supports means B is evidence for A, never the reverse. Cycles, including mutual pairs, are rejected.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "person_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "uniqueItems": true
        },
        "named_subjects": {
          "description": "Explicit inventory of every named person or organization in harmful or sensitive claim/report text. Organization typing is independently checked and cannot override a name that resolves as a person. Registered person claims may omit entries when person_ids and the people registry already resolve the name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedSubject"
          }
        },
        "reasoning": {
          "type": ["string", "null"]
        },
        "decision_relevance": {
          "type": ["string", "null"]
        },
        "what_would_change": {
          "type": ["string", "null"]
        },
        "triangulation": {
          "$ref": "#/$defs/triangulation"
        },
        "resolution": {
          "type": ["string", "null"]
        },
        "limitations": {
          "type": ["string", "null"]
        },
        "time_sensitive": {
          "type": "boolean",
          "default": false
        },
        "evidence_of_absence": {
          "anyOf": [
            {"$ref": "#/$defs/searchRecord"},
            {"type": "null"}
          ]
        }
      }
    },
    "implication": {
      "type": "object",
      "additionalProperties": true,
      "required": ["statement", "claim_ids"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "for_whom": {
          "type": ["string", "null"]
        },
        "timing": {
          "type": ["string", "null"]
        }
      }
    },
    "takeaway": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "statement",
        "rationale_claim_ids",
        "tradeoff",
        "success_signal",
        "failure_signal"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        },
        "success_signal": {
          "type": "string",
          "minLength": 1
        },
        "failure_signal": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "conditions",
        "leading_indicators",
        "disconfirming_indicators",
        "implication",
        "claim_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "leading_indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disconfirming_indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implication": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "central_judgment_claim_ids",
        "counterevidence_claim_ids",
        "adversarial_tests",
        "implications",
        "decisions_or_takeaways",
        "scenarios",
        "limitations",
        "research_stop_reason"
      ],
      "properties": {
        "central_judgment_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "counterevidence_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "adversarial_tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/adversarialTest"
          }
        },
        "implications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implication"
          }
        },
        "decisions_or_takeaways": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/takeaway"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "limitations": {
          "type": ["array", "string", "null"],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "research_stop_reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "adversarialTest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "hypothesis",
        "test",
        "claim_ids",
        "outcome",
        "result",
        "effect_on_conclusion"
      ],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "outcome": {
          "enum": ["supported", "rejected", "unresolved"]
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "effect_on_conclusion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
