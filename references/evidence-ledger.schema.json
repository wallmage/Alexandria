{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wallmage/Alexandria/references/evidence-ledger.schema.json",
  "title": "Alexandria Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "research_question",
    "brief",
    "report_date",
    "coverage",
    "sources",
    "claims",
    "synthesis",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverageItem"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "synthesis": {
      "$ref": "#/$defs/synthesis"
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_reader",
        "decision_or_use",
        "report_language",
        "scope"
      ],
      "properties": {
        "intended_reader": {
          "type": "string",
          "minLength": 1
        },
        "decision_or_use": {
          "type": "string",
          "minLength": 1
        },
        "report_language": {
          "enum": ["en", "zh-CN", "zh-HK"]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "time_horizon",
            "geography",
            "inclusions",
            "exclusions"
          ],
          "properties": {
            "time_horizon": {
              "type": "string",
              "minLength": 1
            },
            "geography": {
              "type": "string",
              "minLength": 1
            },
            "inclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "question",
        "priority",
        "decision_relevance",
        "completion_criteria",
        "status",
        "claim_ids",
        "gap_impact"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["supported", "disputed"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "claim_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "gap"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "gap_impact": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": ["high", "medium", "low"]
        },
        "decision_relevance": {
          "type": "string",
          "minLength": 1
        },
        "completion_criteria": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["unstarted", "in_progress", "supported", "disputed", "gap"]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "gap_impact": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "url",
        "publisher",
        "accessed",
        "provenance",
        "evidence_type",
        "source_family",
        "roles"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": ["string", "null"]
        },
        "published": {
          "type": ["string", "null"],
          "format": "date"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "provenance": {
          "enum": [
            "primary_independent",
            "primary_interested",
            "secondary_independent",
            "secondary_dependent",
            "unverified"
          ]
        },
        "evidence_type": {
          "enum": [
            "accountable_record",
            "peer_reviewed",
            "preprint",
            "official_documentation",
            "dataset_or_test",
            "reported_interview",
            "news_report",
            "opinion_or_forecast",
            "marketing",
            "anecdote"
          ]
        },
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "subject_official",
              "counterparty_official",
              "independent_analysis",
              "empirical_data",
              "affected_stakeholder",
              "expert_interpretation",
              "historical_record"
            ]
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": ["string", "null"]
        }
      }
    },
    "triangulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "enum": ["met", "limited", "not_applicable"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim",
        "kind",
        "importance",
        "source_ids",
        "as_of",
        "confidence",
        "status",
        "include_in_report",
        "report_excerpts",
        "supports",
        "contradicts",
        "reasoning",
        "decision_relevance",
        "what_would_change",
        "triangulation",
        "resolution",
        "limitations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["fact", "reported_claim", "estimate"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              },
              "extract_or_location": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["extract_or_location"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "analysis"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "reasoning": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "properties": {
                  "source_ids": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "supports": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "importance": {
                "const": "key"
              }
            },
            "required": ["importance"]
          },
          "then": {
            "properties": {
              "decision_relevance": {
                "type": "string",
                "minLength": 1
              },
              "what_would_change": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "disputed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "contradicts": {
                "minItems": 1
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "include_in_report": {
                "const": true
              }
            },
            "required": ["include_in_report"]
          },
          "then": {
            "properties": {
              "report_excerpts": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^C[0-9]+$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["fact", "reported_claim", "estimate", "analysis"]
        },
        "importance": {
          "enum": ["key", "supporting", "context"]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "uniqueItems": true
        },
        "extract_or_location": {
          "type": ["string", "null"]
        },
        "as_of": {
          "type": ["string", "null"],
          "format": "date"
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "status": {
          "enum": ["supported", "disputed", "inference", "unknown"]
        },
        "include_in_report": {
          "type": "boolean"
        },
        "report_excerpts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 40
          },
          "uniqueItems": true
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "reasoning": {
          "type": ["string", "null"]
        },
        "decision_relevance": {
          "type": ["string", "null"]
        },
        "what_would_change": {
          "type": ["string", "null"]
        },
        "triangulation": {
          "$ref": "#/$defs/triangulation"
        },
        "resolution": {
          "type": ["string", "null"]
        },
        "limitations": {
          "type": ["string", "null"]
        }
      }
    },
    "implication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "claim_ids"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "for_whom": {
          "type": ["string", "null"]
        },
        "timing": {
          "type": ["string", "null"]
        }
      }
    },
    "takeaway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "rationale_claim_ids",
        "tradeoff",
        "success_signal",
        "failure_signal"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "tradeoff": {
          "type": "string",
          "minLength": 1
        },
        "success_signal": {
          "type": "string",
          "minLength": 1
        },
        "failure_signal": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "conditions",
        "leading_indicators",
        "disconfirming_indicators",
        "implication",
        "claim_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "leading_indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disconfirming_indicators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implication": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "central_judgment_claim_ids",
        "counterevidence_claim_ids",
        "implications",
        "decisions_or_takeaways",
        "scenarios",
        "limitations",
        "research_stop_reason"
      ],
      "properties": {
        "central_judgment_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "counterevidence_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "implications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/implication"
          }
        },
        "decisions_or_takeaways": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/takeaway"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "research_stop_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
