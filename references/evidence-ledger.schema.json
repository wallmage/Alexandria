{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wallmage/Alexandria/references/evidence-ledger.schema.json",
  "title": "Alexandria Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "research_question",
    "brief",
    "people",
    "report_date",
    "coverage",
    "sources",
    "claims",
    "synthesis",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "$ref": "#/$defs/brief"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/coverageItem"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "synthesis": {
      "$ref": "#/$defs/synthesis"
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "brief": {
            "properties": {
              "archetype": {"const": "person"}
            },
            "required": ["archetype"]
          }
        },
        "required": ["brief"]
      },
      "then": {
        "properties": {
          "people": {
            "minItems": 1,
            "contains": {
              "properties": {
                "relationship": {"const": "primary_subject"}
              },
              "required": ["relationship"]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_reader",
        "decision_or_use",
        "archetype",
        "report_language",
        "editorial_mode",
        "scope"
      ],
      "properties": {
        "intended_reader": {
          "type": "string",
          "minLength": 1
        },
        "decision_or_use": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "enum": [
            "artifact",
            "concept",
            "event",
            "organization",
            "person",
            "system",
            "hybrid"
          ]
        },
        "report_language": {
          "enum": ["en", "zh-CN", "zh-HK"]
        },
        "editorial_mode": {
          "enum": [
            "analytical",
            "narrative",
            "explanatory",
            "investigative",
            "historical",
            "critical"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "time_horizon",
            "geography",
            "inclusions",
            "exclusions"
          ],
          "properties": {
            "time_horizon": {
              "type": "string",
              "minLength": 1
            },
            "geography": {
              "type": "string",
              "minLength": 1
            },
            "inclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "question",
        "priority",
        "decision_relevance",
        "completion_criteria",
        "status",
        "claim_ids",
        "gap_impact"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["supported", "disputed"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "claim_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "gap"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "claim_ids": {
                "maxItems": 0
              },
              "gap_impact": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": ["high", "medium", "low"]
        },
        "decision_relevance": {
          "type": "string",
          "minLength": 1
        },
        "completion_criteria": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["unstarted", "in_progress", "supported", "disputed", "gap"]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "gap_impact": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "url",
        "publisher",
        "accessed",
        "provenance",
        "evidence_type",
        "source_family",
        "roles",
        "accountability_basis"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": ["string", "null"]
        },
        "published": {
          "type": ["string", "null"],
          "format": "date"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "provenance": {
          "enum": [
            "primary_independent",
            "primary_interested",
            "secondary_independent",
            "secondary_dependent",
            "unverified"
          ]
        },
        "evidence_type": {
          "enum": [
            "accountable_record",
            "peer_reviewed",
            "preprint",
            "official_documentation",
            "dataset_or_test",
            "reported_interview",
            "news_report",
            "opinion_or_forecast",
            "marketing",
            "anecdote"
          ]
        },
        "source_family": {
          "description": "Independence family. Default to the source URL's registrable domain (or its leading label). Any other value needs family_justification.",
          "type": "string",
          "minLength": 1
        },
        "family_justification": {
          "description": "Why this source is genuinely independent of the other sources sharing its host or registrable domain. Required to override the domain-derived family or to carry a different provenance class from a same-host source.",
          "type": ["string", "null"],
          "minLength": 40
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "subject_official",
              "counterparty_official",
              "independent_analysis",
              "empirical_data",
              "affected_stakeholder",
              "expert_interpretation",
              "historical_record"
            ]
          },
          "uniqueItems": true
        },
        "accountability_basis": {
          "enum": [
            "none",
            "court_or_regulator_record",
            "named_source_investigation",
            "subject_admission"
          ]
        },
        "accountability_note": {
          "type": ["string", "null"],
          "minLength": 40
        },
        "limitations": {
          "type": ["string", "null"]
        },
        "undated_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "name",
        "aliases",
        "living_status",
        "public_role",
        "relationship"
      ],
      "properties": {
        "person_id": {
          "type": "string",
          "pattern": "^P[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "living_status": {
          "enum": ["living", "recently_deceased", "deceased", "unknown"]
        },
        "public_role": {
          "enum": ["public", "limited_public", "private"]
        },
        "relationship": {
          "enum": ["primary_subject", "adjacent"]
        }
      }
    },
    "searchRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queries", "expected_locations", "searched_at"],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expected_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "searched_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "rightOfReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "response_claim_ids", "search_record"],
      "properties": {
        "status": {
          "enum": [
            "documented",
            "declined",
            "no_public_response",
            "not_applicable"
          ]
        },
        "response_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "search_record": {
          "anyOf": [
            {"$ref": "#/$defs/searchRecord"},
            {"type": "null"}
          ]
        }
      }
    },
    "humanHarmReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "legal_stage",
        "source_floor",
        "accountable_source_ids",
        "attributed_to",
        "sourcing_limitation_excerpt",
        "event_period",
        "resolution_status",
        "resolution_claim_ids",
        "resolution_search",
        "right_of_reply",
        "privacy_basis",
        "privacy_basis_source_ids",
        "governing_question_relevance"
      ],
      "properties": {
        "category": {
          "enum": [
            "wrongdoing",
            "misconduct",
            "personal_failing",
            "sensitive_private_fact"
          ]
        },
        "legal_stage": {
          "enum": [
            "alleged",
            "investigated",
            "charged",
            "indicted",
            "settled_no_admission",
            "settled_with_admission",
            "found_liable",
            "convicted",
            "acquitted",
            "overturned",
            "expunged",
            "retracted",
            "nonlegal"
          ]
        },
        "source_floor": {
          "enum": ["met", "single_source_limited"]
        },
        "accountable_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "uniqueItems": true
        },
        "attributed_to": {
          "type": "string",
          "minLength": 1
        },
        "sourcing_limitation_excerpt": {
          "type": ["string", "null"]
        },
        "event_period": {
          "type": "string",
          "minLength": 1
        },
        "resolution_status": {
          "enum": ["unresolved", "resolved", "not_applicable"]
        },
        "resolution_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "resolution_search": {
          "anyOf": [
            {"$ref": "#/$defs/searchRecord"},
            {"type": "null"}
          ]
        },
        "right_of_reply": {
          "anyOf": [
            {"$ref": "#/$defs/rightOfReply"},
            {"type": "null"}
          ]
        },
        "privacy_basis": {
          "enum": [
            "not_sensitive",
            "self_disclosed",
            "court_or_regulator_record"
          ]
        },
        "privacy_basis_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "uniqueItems": true
        },
        "governing_question_relevance": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "triangulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "enum": ["met", "limited", "not_applicable"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "extract_or_location"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[0-9]+$"
        },
        "extract_or_location": {
          "description": "The exact extract or precise location supplied by this individual source. Live fidelity checks bind probes to this source only.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim",
        "kind",
        "importance",
        "source_ids",
        "as_of",
        "confidence",
        "status",
        "include_in_report",
        "report_excerpts",
        "supports",
        "contradicts",
        "person_ids",
        "human_harm_review",
        "reasoning",
        "decision_relevance",
        "what_would_change",
        "triangulation",
        "resolution",
        "limitations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_ids": {
                "minItems": 1
              }
            },
            "required": ["source_ids"]
          },
          "then": {
            "properties": {
              "source_evidence": {
                "minItems": 1
              }
            },
            "required": ["source_evidence"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["fact", "reported_claim", "estimate"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1
              },
              "extract_or_location": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["extract_or_location"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "estimate"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "assumptions": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": ["assumptions"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "analysis"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "reasoning": {
                "type": "string",
                "minLength": 1
              }
            },
            "anyOf": [
              {
                "properties": {
                  "source_ids": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "supports": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "importance": {
                "const": "key"
              }
            },
            "required": ["importance"]
          },
          "then": {
            "properties": {
              "decision_relevance": {
                "type": "string",
                "minLength": 1
              },
              "what_would_change": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "disputed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "contradicts": {
                "minItems": 1
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "include_in_report": {
                "const": true
              }
            },
            "required": ["include_in_report"]
          },
          "then": {
            "properties": {
              "report_excerpts": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "person_ids": {
                "minItems": 1
              }
            },
            "required": ["person_ids"]
          },
          "then": {
            "required": ["person_claim_role", "person_claim_assessment"]
          }
        },
        {
          "if": {
            "properties": {
              "person_claim_role": {
                "enum": ["harmful", "sensitive_private_fact"]
              }
            },
            "required": ["person_claim_role"]
          },
          "then": {
            "properties": {
              "human_harm_review": {
                "$ref": "#/$defs/humanHarmReview"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "person_claim_role": {
                "const": "response"
              }
            },
            "required": ["person_claim_role"]
          },
          "then": {
            "required": ["responds_to_claim_ids"],
            "properties": {
              "responds_to_claim_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "person_claim_role": {
                "const": "resolution"
              }
            },
            "required": ["person_claim_role"]
          },
          "then": {
            "required": ["resolves_claim_ids"],
            "properties": {
              "resolves_claim_ids": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^C[0-9]+$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["fact", "reported_claim", "estimate", "analysis"]
        },
        "importance": {
          "enum": ["key", "supporting", "context"]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "uniqueItems": true
        },
        "extract_or_location": {
          "description": "The quoted or located evidence behind claim. Every quantitative token and status assertion in claim must be covered here or declared in derived_assertions.",
          "type": ["string", "null"]
        },
        "source_evidence": {
          "description": "One evidence record per direct source_id. Cross-reference validation requires exact, unique coverage.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceEvidence"
          }
        },
        "as_of": {
          "description": "The date the claim was true of the world.",
          "type": ["string", "null"],
          "format": "date"
        },
        "verified_at": {
          "description": "The date the extract was last re-read against the live source. Distinct from as_of: re-dating a claim is not re-verifying it.",
          "type": ["string", "null"],
          "format": "date"
        },
        "assumptions": {
          "description": "Stated inputs and steps behind original arithmetic. Required for kind estimate.",
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "minLength": 20
          },
          "uniqueItems": true
        },
        "derived_assertions": {
          "description": "Narrow escape hatch: assertions in claim that are computed or inferred rather than quoted. Each entry names the exact expression and states its derivation. Not for restating the source.",
          "type": ["array", "null"],
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expression", "derivation"],
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "derivation": {
                "type": "string",
                "minLength": 40
              }
            }
          }
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "status": {
          "enum": ["supported", "disputed", "inference", "unknown"]
        },
        "include_in_report": {
          "type": "boolean"
        },
        "report_excerpts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          },
          "uniqueItems": true
        },
        "supports": {
          "description": "Strictly downward: the claims this claim rests on. Listing B in A.supports means B is evidence for A, never the reverse. Cycles, including mutual pairs, are rejected.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "contradicts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "person_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "uniqueItems": true
        },
        "person_claim_role": {
          "description": "Required whenever person_ids is non-empty. Classifies the claim before vocabulary-based safety checks so harmful, private, response, and resolution claims cannot rely on a finite keyword list.",
          "enum": [
            "neutral",
            "harmful",
            "sensitive_private_fact",
            "response",
            "resolution"
          ]
        },
        "person_claim_assessment": {
          "description": "Human/agent semantic screening for every person-linked claim. It makes the role decision explicit instead of treating a finite keyword list as the classifier.",
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "rationale"],
          "properties": {
            "classification": {
              "enum": [
                "neutral",
                "harmful",
                "sensitive_private_fact",
                "response",
                "resolution"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 40
            }
          }
        },
        "responds_to_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
        "resolves_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "uniqueItems": true
        },
