{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wallmage/Alexandria/references/claim-input.schema.json",
  "title": "Alexandria claim-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim",
    "source_evidence"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^C[0-9]+$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["fact", "reported_claim", "estimate", "analysis"]
    },
    "importance": {
      "enum": ["key", "supporting", "context"]
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "extract_or_location"],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "extract_or_location": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "as_of": {
      "type": ["string", "null"]
    },
    "time_sensitive": {
      "type": "boolean"
    },
    "person_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P[0-9]+$"
      }
    },
    "person_claim_role": {
      "type": "string"
    },
    "person_claim_assessment": {
      "type": "object"
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string"
    },
    "decision_relevance": {
      "type": ["string", "null"]
    },
    "named_subjects": {
      "type": "array"
    },
    "limitations": {
      "type": ["string", "null"]
    },
    "what_would_change": {
      "type": ["string", "null"]
    },
    "derived_assertions": {
      "type": "array"
    },
    "evidence_of_absence": {
      "type": "object"
    },
    "human_harm_review": {
      "type": ["object", "null"]
    },
    "reasoning": {
      "type": "string"
    },
    "assumptions": {
      "type": "array"
    },
    "responds_to_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolves_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "triangulation": {
      "type": "object"
    },
    "report_paragraph": {
      "type": "integer"
    }
  }
}
